##################################################################################################################################################
### :::::: Pull OS with kernel :::::: ###
##################################################################################################################################################
FROM docker.io/cachyos/cachyos-v3:latest AS cachyos

# :::::: Prepare the kernel :::::: 
  RUN rm -rf /lib/modules/*
  RUN pacman -Syy --disable-sandbox --noconfirm archlinux-keyring cachyos-keyring || curl -fsSL https://github.com/CachyOS/CachyOS-PKGBUILDS/raw/refs/heads/master/cachyos-mirrorlist/cachyos-mirrorlist -o /etc/pacman.d/cachyos-mirrorlist
  #RUN pacman -Syy --disable-sandbox --noconfirm
  #RUN pacman -S --disable-sandbox --noconfirm archlinux-keyring cachyos-keyring
  RUN pacman -Syy --disable-sandbox --noconfirm
  RUN pacman -S --disable-sandbox --noconfirm linux-cachyos-rc-nvidia-open linux-cachyos-rc-headers
  #RUN pacman -S --disable-sandbox --noconfirm vulkan-tools vulkan-icd-loader lib32-vulkan-icd-loader dkms

##################################################################################################################################################
### :::::: Pull actual system OS :::::: ###
##################################################################################################################################################
FROM ghcr.io/ublue-os/bazzite-nvidia-open:stable

#  :::::: Nvidia fixes #1 :::::: 
  RUN dnf5 -y remove nvidia-gpu-firmware nvidia-driver-common

# :::::: forcefully remove and replace kernel :::::: 
# this is where the magic happens!

# removing any bazzite kernel present by force...  
  RUN rm -rf /lib/modules/*

# ...and then forcing in the cachyos kernel we installed earlier instead.  
  COPY --from="cachyos" /lib/modules /lib/modules

# licenses, since we don't want to get in trouble...
  COPY --from="cachyos" /usr/share/licenses /usr/share/licenses

#  :::::: Nvidia fixes #2 :::::: 
RUN dnf5 -y install dkms
RUN dnf5 -y install nvidia-gpu-firmware
RUN dnf5 -y install nvidia-driver-*
RUN dnf5 -y install vulkan-tools
RUN dnf5 -y install vulkan-loader

# now we must relabel them to support selinux. 
  RUN restorecon -RFv /lib/modules /usr/share/licenses

##################################################################################################################################################
### :::::: Modifications :::::: ###
##################################################################################################################################################
# :::::: disable countme :::::: 
# ( sorry, I know it's safe, but I prefer my telemetry opt-in. )
  RUN sed -i -e s,countme=1,countme=0, /etc/yum.repos.d/*.repo && systemctl mask --now rpm-ostree-countme.timer || true

# :::::: install controld dns :::::: 
# can be activated manually
  RUN curl -fsSL https://dl.controld.com/linux-amd64/ctrld -o /usr/bin/ctrld && chmod 755 /usr/bin/ctrld

# :::::: tells distrobox to use a sub-directory for /home :::::: 
# ...but only when using the command line!
  RUN mkdir -p /usr/share/distrobox/
  RUN touch /usr/share/distrobox/distrobox.conf
  RUN echo "DBX_CONTAINER_HOME_PREFIX=~/distrobox" >> /usr/share/distrobox/distrobox.conf
  RUN dnf5 -y install --allowerasing distrobox

# :::::: install preformence-related stuff :::::: 
RUN dnf5 -y copr enable bieszczaders/kernel-cachyos-addons
  RUN dnf5 -y install --allowerasing scx-scheds
  RUN dnf5 -y install --allowerasing scx-tools 
  RUN dnf5 -y install --allowerasing scxctl
  RUN dnf5 -y swap zram-generator-defaults cachyos-settings
  RUN dnf5 -y install --allowerasing uksmd scx-manager
  RUN dnf5 -y install --allowerasing ananicy-cpp
  RUN dnf5 -y install --allowerasing uksmd
RUN dnf5 -y copr disable bieszczaders/kernel-cachyos-addons

# :::::: Install Some Packages :::::: 
# each line installs a new package, to make debugging easier.
  RUN sed -i 's/^enabled=0$/enabled=1/' /etc/yum.repos.d/terra* # - enable terra repos
      RUN dnf5 -y install --allowerasing zcfan # - can be activated manually
      RUN dnf5 -y install --allowerasing kde-partitionmanager
  RUN sed -i 's/^enabled=1$/enabled=0/' /etc/yum.repos.d/terra* # - disable terra repos

# ::::::  Set vm.max_map_count for stability/improved gaming performance :::::: 
# as recommended here: https://wiki.archlinux.org/title/Gaming#Increase_vm.max_map_count
  RUN echo -e "vm.max_map_count = 2147483642" > /etc/sysctl.d/80-gamecompatibility.conf

##################################################################################################################################################
### :::::: Security and Finalization :::::: ###
##################################################################################################################################################

# :::::: Fix SELinux :::::: 
# tell Grub to add kargs - without them SELinux and nvidia-drivers might not work
  RUN echo 'kargs = ["lsm=landlock,lockdown,yama,integrity,selinux,bpf", "selinux=1", "enforcing=1", "selinux_dontaudit=0", "selinux_deny_unknown=1"]' > /usr/lib/bootc/kargs.d/90-security-overrides.toml

# :::::: Add support for SecureBoot :::::: 
RUN dnf5 -y install --allowerasing mokutil sbsigntools

RUN sed -i -E '/sudo mokutil --timeout -1/a \    echo -e "$ENROLLMENT_PASSWORD\\n$ENROLLMENT_PASSWORD" | sudo mokutil --import "$SECUREBOOT_KEY2"' /usr/share/ublue-os/just/00-default.just
RUN sed -i -E '/akmods-ublue.der/a \    SECUREBOOT_KEY2=/usr/share/cert/MOK.der' /usr/share/ublue-os/just/00-default.just

# :::::: Slot the kernel into place :::::: 
# this section is the only reason this project is possible!!! do not change it and do not move it around.
RUN mkdir -p /var/tmp
RUN printf "systemdsystemconfdir=/etc/systemd/system\nsystemdsystemunitdir=/usr/lib/systemd/system\n" | tee /usr/lib/dracut/dracut.conf.d/30-bootcrew-fix-bootc-module.conf && \
      printf 'hostonly=no\nadd_dracutmodules+=" ostree bootc "' | tee /usr/lib/dracut/dracut.conf.d/30-bootcrew-bootc-modules.conf && \
      sh -c 'export KERNEL_VERSION="$(basename "$(find /usr/lib/modules -maxdepth 1 -type d | grep -v -E "*.img" | tail -n 1)")" && \
      dracut --force --no-hostonly --reproducible --zstd --verbose --kver "$KERNEL_VERSION"  "/usr/lib/modules/$KERNEL_VERSION/initramfs.img"'

#  :::::: Finish :::::: 
# finally!!!
# remove clutter
RUN dnf5 -y clean all && rm -rf /var/cache/dnf /var/lib/dnf /tmp/*

CMD ["/sbin/init"]
LABEL containers.bootc 1
RUN bootc container lint
