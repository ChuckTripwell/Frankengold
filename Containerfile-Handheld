FROM ghcr.io/ohaiibuzzle/cachy-bootc:latest AS base

RUN pacman -Sy --disable-sandbox --noconfirm
RUN pacman -Sy --disable-sandbox --noconfirm archlinux-keyring cachyos-keyring wget
RUN pacman -Sy --disable-sandbox --noconfirm
RUN cd /tmp/ && wget -s https://raw.githubusercontent.com/CachyOS/cachyos-calamares/refs/heads/cachyos-deckify-qt6/src/modules/netinstall/netinstall.yaml
RUN pacman -S --disable-sandbox --noconfirm $(awk '/packages:/ {if($0~/\[/) {l=$0; sub(/.*\[/,"",l); sub(/\].*/,"",l); gsub(/["\x27]/,"",l); n=split(l,a,/,/); for(k=1;k<=n;k++) {gsub(/^[[:space:]]+|[[:space:]]+$/,"",a[k]); if(a[k]!="" && tolower(a[k])!~/firefox/) printf "%s ", a[k]}} else {f=1; i=match($0,/[^[:space:]]/)-1; next}} f {if(match($0,/[^[:space:]]/)-1<=i && $0!~/^[[:space:]]*$/) f=0; else if($0~/^[[:space:]]*-[[:space:]]/) {s=$0; sub(/^[[:space:]]*-[[:space:]]*/,"",s); sub(/#.*/,"",s); gsub(/["\x27]/,"",s); gsub(/^[[:space:]]+|[[:space:]]+$/,"",s); if(s!="" && tolower(s)!~/firefox/) printf "%s ", s}}' /tmp/netinstall.yaml)

RUN yes | pacman -Scc

RUN systemctl enable sddm

LABEL containers.bootc 1
RUN bootc container lint
