FROM ghcr.io/ohaiibuzzle/cachy-bootc:latest AS base

#pacman -Scc --noconfirm || true
rm -rf /var/lib/pacman/sync/*

RUN rm -rf /usr/lib/modules/*

RUN pacman -Sy --disable-sandbox --noconfirm
RUN pacman -Sy --disable-sandbox --noconfirm archlinux-keyring cachyos-keyring wget
RUN cd /tmp/ && wget https://raw.githubusercontent.com/CachyOS/cachyos-calamares/refs/heads/cachyos-deckify-qt6/src/modules/netinstall/netinstall.yaml
RUN pacman -Sy --disable-sandbox --noconfirm
RUN pacman -Syu --disable-sandbox --noconfirm $(awk '/packages:/ {if($0~/\[/) {l=$0; sub(/.*\[/,"",l); sub(/\].*/,"",l); gsub(/["\x27]/,"",l); n=split(l,a,/,/); for(k=1;k<=n;k++) {gsub(/^[[:space:]]+|[[:space:]]+$/,"",a[k]); if(a[k]!="" && tolower(a[k])!~/firefox/) printf "%s ", a[k]}} else {f=1; i=match($0,/[^[:space:]]/)-1; next}} f {if(match($0,/[^[:space:]]/)-1<=i && $0!~/^[[:space:]]*$/) f=0; else if($0~/^[[:space:]]*-[[:space:]]/) {s=$0; sub(/^[[:space:]]*-[[:space:]]*/,"",s); sub(/#.*/,"",s); gsub(/["\x27]/,"",s); gsub(/^[[:space:]]+|[[:space:]]+$/,"",s); if(s!="" && tolower(s)!~/firefox/) printf "%s ", s}}' /tmp/netinstall.yaml)

#pacman -Scc --noconfirm || true
rm -rf /var/lib/pacman/sync/*

# :::::: slot the kernel into place :::::: 
RUN mkdir -p /var/tmp
RUN printf "systemdsystemconfdir=/etc/systemd/system\nsystemdsystemunitdir=/usr/lib/systemd/system\n" | tee /usr/lib/dracut/dracut.conf.d/30-bootcrew-fix-bootc-module.conf && \
      printf 'hostonly=no\nadd_dracutmodules+=" ostree bootc "' | tee /usr/lib/dracut/dracut.conf.d/30-bootcrew-bootc-modules.conf && \
      sh -c 'export KERNEL_VERSION="$(basename "$(find /usr/lib/modules -maxdepth 1 -type d | grep -v -E "*.img" | tail -n 1)")" && \
      dracut --force --no-hostonly --reproducible --zstd --verbose --kver "$KERNEL_VERSION"  "/usr/lib/modules/$KERNEL_VERSION/initramfs.img"'
#
#  :::::: finish :::::: 
RUN rm -rf /usr/etc
LABEL containers.bootc 1
RUN bootc container lint
