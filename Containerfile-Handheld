FROM docker.io/cachyos/cachyos-v3:latest AS builder
RUN pacman -Sy --noconfirm git && \
    git clone https://aur.archlinux.org/bootc.git /bootc && \
    rm -r /bootc/.git && \
    useradd -m builder && \
    echo 'builder ALL=(ALL) NOPASSWD: ALL' >> /etc/sudoers && \
    install -d -o builder /bootc
USER builder
WORKDIR /bootc
RUN makepkg -cs --noconfirm


FROM docker.io/cachyos/cachyos-v3:latest AS bootstrapper
COPY --from=builder /bootc/bootc-*.pkg.tar.zst /tmp
COPY files /mnt
RUN pacman -Sy --noconfirm arch-install-scripts && \
    pacstrap /mnt base && \
    pacstrap -U /mnt /tmp/bootc-*.pkg.tar.zst && \
    mv /mnt/var/lib/pacman /mnt/usr/lib/pacman


FROM scratch AS base

COPY --from=bootstrapper /mnt /
RUN pacman -Scc --noconfirm && \
    # nonempty-boot
    rm -rf /boot/* && \
    # nonempty-run-tmp
    rm -rf /run/* /tmp/* && \
    # var-log
    rm -rf /var/log/* && \
    # var-tmpfiles
    rm -rf /var/cache/* /var/log/* /var/db/* /var/lib/* && \
   # bootc container lint --fatal-warnings


FROM base AS installer
RUN pacman -S linux-firmware wpa_supplicant skopeo dosfstools e2fsprogs --noconfirm && \
    systemctl enable systemd-networkd.service && \
    systemctl enable systemd-resolved.service && \
    ln -s /usr/lib/systemd/network/80-wifi-station.network.example /etc/systemd/network/80-wifi-station.network && \
    ln -s /usr/lib/systemd/network/89-ethernet.network.example /etc/systemd/network/89-ethernet.network && \
    passwd -d root










RUN pacman -Scc --noconfirm || true
RUN rm -rf /var/lib/pacman/sync/*

RUN rm -rf /usr/lib/modules/*

RUN pacman -Sy --disable-sandbox --noconfirm
RUN pacman -Syy --disable-sandbox --noconfirm archlinux-keyring cachyos-keyring curl
RUN curl https://raw.githubusercontent.com/CachyOS/cachyos-calamares/refs/heads/cachyos-deckify-qt6/src/modules/netinstall/netinstall.yaml > /tmp/packages.txt
RUN pacman -Sy --disable-sandbox --noconfirm
RUN pacman -S --disable-sandbox --noconfirm $(awk '/packages:/ {if($0~/\[/) {l=$0; sub(/.*\[/,"",l); sub(/\].*/,"",l); gsub(/["\x27]/,"",l); n=split(l,a,/,/); for(k=1;k<=n;k++) {gsub(/^[[:space:]]+|[[:space:]]+$/,"",a[k]); if(a[k]!="" && tolower(a[k])!~/firefox/) printf "%s ", a[k]}} else {f=1; i=match($0,/[^[:space:]]/)-1; next}} f {if(match($0,/[^[:space:]]/)-1<=i && $0!~/^[[:space:]]*$/) f=0; else if($0~/^[[:space:]]*-[[:space:]]/) {s=$0; sub(/^[[:space:]]*-[[:space:]]*/,"",s); sub(/#.*/,"",s); gsub(/["\x27]/,"",s); gsub(/^[[:space:]]+|[[:space:]]+$/,"",s); if(s!="" && tolower(s)!~/firefox/) printf "%s ", s}}' /tmp/packages.txt)

RUN pacman -Scc --noconfirm || true
RUN rm -rf /var/lib/pacman/sync/*

# :::::: slot the kernel into place :::::: 
RUN mkdir -p /var/tmp
RUN printf "systemdsystemconfdir=/etc/systemd/system\nsystemdsystemunitdir=/usr/lib/systemd/system\n" | tee /usr/lib/dracut/dracut.conf.d/30-bootcrew-fix-bootc-module.conf && \
      printf 'hostonly=no\nadd_dracutmodules+=" ostree bootc "' | tee /usr/lib/dracut/dracut.conf.d/30-bootcrew-bootc-modules.conf && \
      sh -c 'export KERNEL_VERSION="$(basename "$(find /usr/lib/modules -maxdepth 1 -type d | grep -v -E "*.img" | tail -n 1)")" && \
      dracut --force --no-hostonly --reproducible --zstd --verbose --kver "$KERNEL_VERSION"  "/usr/lib/modules/$KERNEL_VERSION/initramfs.img"'
#
#  :::::: finish :::::: 
RUN rm -rf /usr/etc
LABEL containers.bootc 1
RUN bootc container lint
